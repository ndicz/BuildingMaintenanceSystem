# Alamat database PostgreSQL.
# - Lokal: Postgres di komputer sendiri, mis. postgresql://postgres:postgres@localhost:5432/maintenance
# - Atau database gratis di Neon (neon.tech): salin "connection string" dari dashboard Neon.
# - Di Vercel: otomatis terisi saat database Neon dihubungkan ke project.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maintenance"

# Kunci rahasia untuk sesi login. Ganti dengan teks acak panjang (min. 32 karakter).
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="ganti-dengan-teks-acak-yang-panjang-minimal-32-karakter"

# Item dianggap "Segera" bila sisa jam <= persentase ini dari interval.
SOON_THRESHOLD_PERCENT=10

# Tampilkan akun demo di halaman login (untuk link demo). Kosongkan untuk pemakaian sungguhan.
DEMO_MODE=""

# Password awal akun yang dibuat saat database pertama kali diisi (opsional).
# SEED_ADMIN_PASSWORD="admin123"
# SEED_TEKNISI_PASSWORD="teknisi123"
